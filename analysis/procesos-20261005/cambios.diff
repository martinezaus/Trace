+    private function ms($time): int {
+        if (!preg_match('/^(\d+):([0-5]\d):([0-5]\d)$/',(string)$time,$m)) return 0;
+        return ((int)$m[1]*3600+(int)$m[2]*60+(int)$m[3])*1000;
+    }
+    private function time(int $ms): string {
