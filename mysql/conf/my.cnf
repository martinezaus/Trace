[mysqld]
# Codificación
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Conexiones (ajustar según carga real de usuarios concurrentes)
max_connections = 150
wait_timeout = 300
interactive_timeout = 300

# InnoDB - motor transaccional, importante para concurrencia
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

# Logs lentos (útil para detectar queries que traban por concurrencia)
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow-query.log
long_query_time = 2

# Seguridad
local_infile = 0

[client]
default-character-set = utf8mb4